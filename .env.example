# Copiar a .env y ajustar. Sin este archivo (o sin ninguna env var seteada),
# el stack arranca en modo local: cero llamadas a AWS, cero credenciales.

# --- Selector de stack --------------------------------------------------
# "local" (default): FakeEmbeddings + MemoryVectorStore + FalkorDB + FakeRerank + ScriptedLlm
# "aws": Bedrock (Nova 2 Embeddings + Nova Micro por default, Cohere Rerank — Pro a un env var) + S3 Vectors + FalkorDB (mismo grafo que en local)
SECOND_BRAIN_MODE=local

# --- Modo local -----------------------------------------------------------
# Dimensión del vector de FakeEmbeddings (hashing trick sobre bag-of-words).
SECOND_BRAIN_EMBEDDINGS_DIM=256

# FalkorDB corre en Docker: docker run -p 6379:6379 falkordb/falkordb
# Estas 3 variables valen para los dos modos: FalkorDB es el motor único de
# grafo del proyecto. En modo "aws" no hay ningún FalkorDB desplegado por el
# CDK (ver demo/infra/README.md) — el default de abajo apunta a localhost;
# si el grafo llega a vivir en un host remoto, cambiá solo estas 3 líneas.
SECOND_BRAIN_FALKOR_HOST=localhost
SECOND_BRAIN_FALKOR_PORT=6379
SECOND_BRAIN_FALKOR_GRAPH_NAME=secondbrain

# Quien CONSTRUYE el grafo. Los dos backends le hablan a FalkorDB por el
# conector del GraphRAG Toolkit (`GraphStoreFactory`); lo que cambia es quien
# escribio el grafo y con que esquema.
#
#   propio  (default) -> `Entidad`/`RELACION`, extractor por patrones de
#                        `graph/extraction.py`. Determinista, sin red, y con
#                        vocabulario controlado (CONSUME/DEPENDE_DE/LLAMA_A).
#   toolkit           -> `__Entity__`/`__RELATION__`, escrito por
#                        `LexicalGraphIndex` del toolkit. Se construye con
#                        `scripts/toolkit_extract_build.py` (extract con LLM
#                        real UNA vez -> JSON versionable; build offline en
#                        cada ensayo), NO con `demo.py ingest`.
#
# Los dos grafos coexisten en bases distintas de FalkorDB, asi que se puede
# alternar sin reingestar — util para mostrarlos lado a lado en la charla.
SECOND_BRAIN_GRAPH_BACKEND=propio
SECOND_BRAIN_TOOLKIT_GRAPH_NAME=toolkitgrafo
SECOND_BRAIN_CORPUS_PATH=corpus

# Que LlmPort usa el modo local para REDACTAR la respuesta.
#
#   scripted (default) -> `ScriptedLlm`: respuestas guionadas, sin ningun
#                         modelo. Es lo que hace que `demo.py check` sea
#                         determinista y que el ensayo no necesite red.
#   bedrock            -> `BedrockLlm` real (Nova Micro por default), pero
#                         dejando embeddings/vector store/rerank LOCALES.
#                         Sirve para mostrar en la UI texto generado de
#                         verdad sin escribir nada en AWS: la inferencia de
#                         Bedrock no crea recursos (a diferencia de
#                         SECOND_BRAIN_MODE=aws, que escribe embeddings en
#                         S3 Vectors). Necesita credenciales AWS validas.
#
# Con `bedrock`, `demo.py check` deja de tener sentido: las 20
# verificaciones afirman contenido del guion, no lo que redacte un modelo.
SECOND_BRAIN_LOCAL_LLM=scripted

# Path opcional para persistir el índice vectorial en memoria entre corridas
# (se guarda como <path>.npz + <path>.json). Vacío = solo en RAM.
SECOND_BRAIN_VECTOR_STORE_PATH=

# --- Modo AWS ---------------------------------------------------------
SECOND_BRAIN_AWS_REGION=us-east-1

SECOND_BRAIN_BEDROCK_EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
SECOND_BRAIN_BEDROCK_EMBEDDINGS_DIM=1024
SECOND_BRAIN_BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
# Default: amazon.nova-micro-v1:0 (~20x mas barato que Pro y verificado con el
# gancho de Billing 2.0). Descomentar para subir a Pro:
# SECOND_BRAIN_BEDROCK_LLM_MODEL_ID=amazon.nova-pro-v1:0

# Guardrail opcional. Si SECOND_BRAIN_BEDROCK_GUARDRAIL_ID queda vacío, el
# adapter llama a Bedrock sin guardrailConfig (útil para ensayar sin uno
# provisionado todavía).
SECOND_BRAIN_BEDROCK_GUARDRAIL_ID=
SECOND_BRAIN_BEDROCK_GUARDRAIL_VERSION=
SECOND_BRAIN_BEDROCK_GUARDRAIL_TRACE=enabled

SECOND_BRAIN_S3_VECTORS_BUCKET=
SECOND_BRAIN_S3_VECTORS_INDEX_NAME=

# --- Memoria (opcional, ver openspec/changes/agregar-memoria-second-brain/) ---
# Apagada por default a propósito: activarla implica escritura (CreateEvent)
# además de lectura, así que nunca debe encenderse sola. Aplica a los DOS
# modos: en "local" habilita un FakeMemoryStore en RAM (sin AWS); en "aws"
# habilita AgentCore Memory, pero solo si además hay un id abajo.
SECOND_BRAIN_MEMORY_ENABLED=false
# Id del recurso AgentCore Memory ya desplegado (infra/stacks/agentcore_stack.py).
# Específico de la cuenta: dejalo SIEMPRE vacío acá — nunca lo hardcodees ni
# lo commitees con un valor real. Solo se usa en modo "aws".
SECOND_BRAIN_AGENTCORE_MEMORY_ID=
# Actor de demo (quien "recuerda"): los namespaces de hechos/preferencias en
# AgentCore Memory son second_brain/{actorId}/hechos y
# second_brain/{actorId}/preferencias.
SECOND_BRAIN_AGENTCORE_ACTOR_ID=demo-speaker

# --- Observabilidad del loop agéntico (Strands, OTel nativo) -----------
# No afecta a la traza propia (TraceStep, `--trace`, la UI web): las dos
# coexisten (ver `agent/observability.py`). Apagado por default: en ese
# caso ni se importa `strands.telemetry`, cero costo.
SECOND_BRAIN_OTEL_ENABLED=false
# Imprime cada span de Strands por stdout, además de exportarlo (si hay
# endpoint configurado). Útil para ver el árbol de spans sin un collector.
SECOND_BRAIN_OTEL_CONSOLE=false
# Env var ESTÁNDAR de OpenTelemetry (no tiene prefijo SECOND_BRAIN_ a
# propósito: es el mismo que usa cualquier otro exporter OTel). Requiere
# el extra `strands-agents[otel]` instalado (`pip install ".[otel]"`).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Bedrock Knowledge Base como recuperador ADICIONAL del híbrido (opt-in).
# Antes de prenderla: `infra/subir-corpus.py` + `infra/ingestar-knowledge-base.py`
# (las dos ingestas deben cubrir el mismo conjunto de documentos, ver README).
# Apagada, `retrieval.retrieve` funde solo semántico + léxico, igual que siempre.
# Solo tiene efecto en SECOND_BRAIN_MODE=aws y con el id configurado.
SECOND_BRAIN_KNOWLEDGE_BASE_ENABLED=false
SECOND_BRAIN_BEDROCK_KB_ID=
