# Copiar a .env y ajustar. Sin este archivo (o sin ninguna env var seteada),
# el stack arranca en modo local: cero llamadas a AWS, cero credenciales.

# --- Selector de stack --------------------------------------------------
# "local" (default): FakeEmbeddings + MemoryVectorStore + FalkorDB + FakeRerank + ScriptedLlm
# "aws": Bedrock (Nova 2 Embeddings + Nova Micro por default, Cohere Rerank — Pro a un env var) + S3 Vectors + FalkorDB (mismo grafo que en local)
SECOND_BRAIN_MODE=local

# --- Modo local -----------------------------------------------------------
# Dimensión del vector de FakeEmbeddings (hashing trick sobre bag-of-words).
SECOND_BRAIN_EMBEDDINGS_DIM=256

# FalkorDB corre en Docker: docker run -p 6379:6379 falkordb/falkordb
# Estas 3 variables valen para los dos modos: FalkorDB es el motor único de
# grafo del proyecto. En modo "aws" no hay ningún FalkorDB desplegado por el
# CDK (ver demo/infra/README.md) — el default de abajo apunta a localhost;
# si el grafo llega a vivir en un host remoto, cambiá solo estas 3 líneas.
SECOND_BRAIN_FALKOR_HOST=localhost
SECOND_BRAIN_FALKOR_PORT=6379
SECOND_BRAIN_FALKOR_GRAPH_NAME=secondbrain

# Path opcional para persistir el índice vectorial en memoria entre corridas
# (se guarda como <path>.npz + <path>.json). Vacío = solo en RAM.
SECOND_BRAIN_VECTOR_STORE_PATH=

# --- Modo AWS ---------------------------------------------------------
SECOND_BRAIN_AWS_REGION=us-east-1

SECOND_BRAIN_BEDROCK_EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
SECOND_BRAIN_BEDROCK_EMBEDDINGS_DIM=1024
SECOND_BRAIN_BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
# Default: amazon.nova-micro-v1:0 (~20x mas barato que Pro y verificado con el
# gancho de Billing 2.0). Descomentar para subir a Pro:
# SECOND_BRAIN_BEDROCK_LLM_MODEL_ID=amazon.nova-pro-v1:0

# Guardrail opcional. Si SECOND_BRAIN_BEDROCK_GUARDRAIL_ID queda vacío, el
# adapter llama a Bedrock sin guardrailConfig (útil para ensayar sin uno
# provisionado todavía).
SECOND_BRAIN_BEDROCK_GUARDRAIL_ID=
SECOND_BRAIN_BEDROCK_GUARDRAIL_VERSION=
SECOND_BRAIN_BEDROCK_GUARDRAIL_TRACE=enabled

SECOND_BRAIN_S3_VECTORS_BUCKET=
SECOND_BRAIN_S3_VECTORS_INDEX_NAME=

# --- Observabilidad del loop agéntico (Strands, OTel nativo) -----------
# No afecta a la traza propia (TraceStep, `--trace`, la UI web): las dos
# coexisten (ver `agent/observability.py`). Apagado por default: en ese
# caso ni se importa `strands.telemetry`, cero costo.
SECOND_BRAIN_OTEL_ENABLED=false
# Imprime cada span de Strands por stdout, además de exportarlo (si hay
# endpoint configurado). Útil para ver el árbol de spans sin un collector.
SECOND_BRAIN_OTEL_CONSOLE=false
# Env var ESTÁNDAR de OpenTelemetry (no tiene prefijo SECOND_BRAIN_ a
# propósito: es el mismo que usa cualquier otro exporter OTel). Requiere
# el extra `strands-agents[otel]` instalado (`pip install ".[otel]"`).
OTEL_EXPORTER_OTLP_ENDPOINT=
